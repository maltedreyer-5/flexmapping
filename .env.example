# FlexMapping configuration
#
# Copy this file to .env and replace every CHANGE_ME value before use.
# With ENVIRONMENT=production the application refuses to start while any
# CHANGE_ME value, DEBUG=true or DOCS_ENABLED=true is still in place.

# --- Environment ----------------------------------------------------------
ENVIRONMENT=development
# DEBUG returns internal exception text to HTTP clients and echoes SQL.
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Secrets: replace all three -------------------------------------------
# At least 32 characters. Changing it signs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_session_secret_at_least_32_characters_long

# Administrator created on first start, if no account exists yet.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# Key for the OpenAI-compatible backend. Use any non-empty value if your
# endpoint does not check it.
LLM_API_KEY=CHANGE_ME_llm_api_key

# --- Database and queue ---------------------------------------------------
DATABASE_URL=postgresql+asyncpg://flexmap:flexmap@db:5432/flexmap
DATABASE_URL_SYNC=postgresql://flexmap:flexmap@db:5432/flexmap
POSTGRES_PASSWORD=flexmap

REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
# Prefix for all Redis keys, so several instances can share one server.
REDIS_KEY_PREFIX=flexmap

# --- LLM backend ----------------------------------------------------------
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=current-best
LLM_TIMEOUT=30
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.1
LLM_REQUESTS_PER_MINUTE=30
LLM_REQUEST_DELAY=2.0

# --- Worker pool ----------------------------------------------------------
NUM_WORKERS=3
MAX_CONCURRENT_LLM=5

# --- Crawler --------------------------------------------------------------
CRAWLER_USER_AGENT=FlexMapping-Bot/1.0
CRAWLER_TIMEOUT=30
CRAWLER_MAX_MARKDOWN_SIZE=200000
CRAWLER_DEFAULT_RATE_LIMIT=1.0
CRAWLER_MULTI_PAGE_ENABLED=true
CRAWLER_MAX_PAGES=5
# Set false only for hosts you operate yourself.
CRAWLER_VERIFY_SSL=true
CRAWLER_RESPECT_ROBOTS=true

# --- Robustness -----------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=10
CIRCUIT_BREAKER_TIMEOUT=300
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE=2.0

# --- HTTP API -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
# /docs and /redoc list every endpoint, including the destructive ones.
DOCS_ENABLED=false
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Sessions -------------------------------------------------------------
SESSION_MAX_AGE=43200
# Enable once the instance is served over HTTPS.
SESSION_COOKIE_SECURE=false
LOGIN_FAILURE_DELAY=1.0

# --- Static site ----------------------------------------------------------
# Emptied on every generation run. Use a directory reserved for this purpose.
PUBLIC_SITE_DIR=/var/www/flexmap
STATIC_SITE_BASE_URL=http://localhost:8000
# Path the generated site is served under. Empty for a web server or CDN at the
# root. Set to /public to browse it through the application at
# http://localhost:8000/public/
PUBLIC_SITE_URL_PREFIX=

# --- Category configuration -----------------------------------------------
# Defaults to app/config when unset.
# FLEXMAP_CONFIG_DIR=/app/app/config
